# ---- Server ----
PORT=4001
NODE_ENV=development

# ---- Ollama (LLM used to classify intent) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_MS=15000
# Max inferences allowed to run at once. On a single CPU-only local model,
# leave this at 1 — the model can't actually parallelize, and a higher
# number just makes every concurrent request slower.
OLLAMA_MAX_CONCURRENCY=1
# Max requests allowed to wait in line once OLLAMA_MAX_CONCURRENCY is busy.
# Once the backlog hits this size, new /ingest requests get a fast 429
# instead of piling up indefinitely.
OLLAMA_MAX_QUEUE_SIZE=20

# ---- Downstream messaging microservice (apps/whatsapp gateway) ----
# Contract: POST {MESSAGING_SERVICE_URL} with header X-Api-Key: {MESSAGING_SERVICE_API_KEY}
#           body { "phone": string, "text": string }
# MESSAGING_SERVICE_API_KEY must match INTERNAL_API_KEY in apps/whatsapp's .env,
# or every send will 401.
MESSAGING_SERVICE_URL=http://localhost:3000/sendMessage
MESSAGING_SERVICE_API_KEY=dummy
# If the gateway returns 503 (Baileys socket not ready yet), retry this many
# times with a short backoff before giving up.
MESSAGING_SERVICE_MAX_RETRIES=3

# ---- Sales team roster ----
# Either JSON or CSV. Format documented in README.
# JSON: [{ "name": "...", "contactNumber": "...", "role": "DM" | "caller" | "email" }]
# CSV headers: name,contactNumber,role
SALES_TEAM_FILE=./src/data/salesTeam.json

# ---- Cache (in-memory, fast-path deduplication of incoming leads) ----
CACHE_TTL_SECONDS=86400

# ---- SQLite database ----
# Stores every processed lead (discarded/duplicate/assigned) and the
# round-robin assignment counters, so both survive restarts.
DB_FILE=./data/leads.db

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=gsk_...
LLM_MIN_INTERVAL_MS=4000
# ---- Logging ----
LOG_LEVEL=info
