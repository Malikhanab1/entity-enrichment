# ─────────────────────────────────────────────────────────────────────────────
# Facebook Group Poller — environment configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is loaded automatically by run-poller.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Facebook session cookies (required) ──────────────────────────────────────
# Extract these from your browser after logging in to facebook.com.
# In Chrome/Firefox: DevTools → Application → Cookies → facebook.com
#
# The two below are the only ones strictly required. The rest strengthen
# Facebook's session fingerprint and reduce checkpoint challenges.

FACEBOOK_C_USER=          # your numeric Facebook user ID  e.g. 100012345678901
FACEBOOK_XS=              # session token                  e.g. 10%3Aabcd1234...

FACEBOOK_SB=              # browser fingerprint cookie     (recommended)
FACEBOOK_DATR=            # device auth token              (recommended)
FACEBOOK_FR=              # friend/ad tracking token       (optional)
FACEBOOK_PS_L=            # presence status                (optional)
FACEBOOK_PS_N=            # presence status secondary      (optional)

# ── Ingestion endpoint (required) ────────────────────────────────────────────
# The poller will POST to $INGEST_URL/ingest for every new post it finds.

INGEST_URL=               # e.g. https://your-service.example.com

# ── File paths ────────────────────────────────────────────────────────────────

GROUPS_CSV=groups.csv         # CSV of group IDs to monitor
SEEN_FILE=seen_posts.log      # permanent dedup log — never delete this

# ── Polling behaviour ─────────────────────────────────────────────────────────

POLL_INTERVAL=60          # seconds to wait between polling each group

# ── Facebook client tuning (optional) ────────────────────────────────────────

FB_MIN_GAP_MS=800         # min ms between Facebook API requests (default 800)
FB_MAX_RETRIES=3          # retries per request before giving up  (default 3)
FB_PROXY_URL=             # optional proxy e.g. http://user:pass@host:3128
